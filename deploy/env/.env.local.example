# Perfil local (clínica). Copiar a deploy/.env y cambiar la contraseña.
# Generar una: openssl rand -hex 24   (solo letras y números: va dentro de una URL)
POSTGRES_DB=smileos
POSTGRES_USER=smileos
POSTGRES_PASSWORD=cambiar-por-un-valor-largo-y-aleatorio
# Firma de las sesiones: única por instalación, mínimo 32 caracteres. Generar: openssl rand -hex 32
JWT_SECRET=cambiar-por-un-valor-aleatorio-de-al-menos-32-caracteres
HTTP_PORT=80
LOG_LEVEL=INFO
WORKER_POLL_SECONDS=30
