# Perfil nube (presentación): estas variables se cargan en Render (backend).
# Nunca guardar valores reales en el repositorio.
APP_PROFILE=cloud
# Cadena de conexión de Supabase; el prefijo postgresql:// se convierte solo a asyncpg.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/postgres
# URL del frontend en Vercel (varias, separadas por comas).
CORS_ORIGINS=https://smileos.vercel.app
STORAGE_BACKEND=supabase
LOG_LEVEL=INFO
