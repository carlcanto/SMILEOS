# Perfil nube (presentación): estas variables se cargan en el panel de Render (backend).
# Guía paso a paso: docs/despliegue-nube.md. Nunca guardar valores reales en el repositorio.
APP_PROFILE=cloud

# URI del *Session pooler* de Supabase (botón Connect, puerto 5432). Con la contraseña puesta.
# No usar "Direct connection" (IPv6) ni "Transaction pooler" (puerto 6543).
DATABASE_URL=postgresql://postgres.REF:CLAVE@HOST.pooler.supabase.com:5432/postgres

# Firma de las sesiones: única por instalación. Generar: openssl rand -hex 32
JWT_SECRET=cambiar-por-un-valor-aleatorio-de-al-menos-32-caracteres

# El backend crea las tablas al arrancar en cualquier base vacía (cualquier cuenta de Supabase).
RUN_MIGRATIONS_ON_START=true

# Primer administrador: se crea solo si la base no tiene usuarios. Las tres juntas.
# Conviene borrarlas después del primer inicio de sesión.
BOOTSTRAP_ADMIN_EMAIL=admin@ejemplo.com
BOOTSTRAP_ADMIN_NAME=Nombre Apellido
BOOTSTRAP_ADMIN_PASSWORD=cambiar-por-una-contrasena-de-10-o-mas-caracteres

# Origen exacto del frontend en Vercel (varios, separados por comas). Sin barra final.
CORS_ORIGINS=https://smileos.vercel.app

STORAGE_BACKEND=supabase
LOG_LEVEL=INFO
